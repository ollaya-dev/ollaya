# Response headers for Cloudflare Workers static assets (also understood by Cloudflare Pages
# and Netlify). Other static hosts ignore this file; the site works without it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://oa-c.cobanov.run; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://oa-c.cobanov.run; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# /try runs a model in the page (src/pages/try.tsx): WebAssembly needs 'wasm-unsafe-eval', the model's files come
# from Hugging Face (huggingface.co redirects LFS and Xet downloads to its CDN hosts), and cross-origin isolation
# (COOP + COEP) gives onnxruntime-web SharedArrayBuffer for its threads.
/try
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://oa-c.cobanov.run; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://oa-c.cobanov.run https://huggingface.co https://*.huggingface.co https://*.hf.co; worker-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# onnxruntime-web's thread workers: they instantiate the WebAssembly module and live inside /try's isolation.
/static/ort-wasm-simd-threaded*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'none'
  Cross-Origin-Embedder-Policy: credentialless

# Files under /static/ are referenced with a ?v=<content-hash> query, so they can be cached forever.
/static/*
  Cache-Control: public, max-age=31536000, immutable

/install.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/search.json
  Cache-Control: public, max-age=300

/favicon.svg
  Cache-Control: public, max-age=86400

# /v2/ is reserved for the static model registry (manifests copied in by the packaging step).
